<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml — GCO (Capacitor 8)
  Android 7.0 (API 24) → 16+ (API 36+)
  AOSP · Samsung One UI 5–8 · Xiaomi/Redmi HyperOS

  appId: com.savitarxeno.gco

  minSdkVersion = 24

  Objetivo principal:
  - Reproducción de audio en segundo plano fiable (MediaSession + FGS mediaPlayback)
  - Picture-in-Picture para vídeo
  - Soporte agresivo de OEM (Samsung / Xiaomi)
  - Cumplir requisitos de Android 14+ para Foreground Service Types

  Cambios de esta revisión (2026-09):
  1. Se mantiene tools:ignore="BatteryLife" en REQUEST_IGNORE_BATTERY_OPTIMIZATIONS
     (solo se pide bajo demanda del usuario desde useMediaPlayer.ts).
  2. Servicio de @capgo/capacitor-media-session correctamente tipado como
     foregroundServiceType="mediaPlayback" + exported="true" + stopWithTask="false".
  3. Se eliminan atributos innecesarios que disparaban lint.
  4. Se mantienen todos los queries necesarios para ajustes de batería y medios.
  5. Activity con supportsPictureInPicture="true" para vídeo en ventana flotante.
  6. Comentarios actualizados y limpios.

  Aviso que Android Studio seguirá mostrando y que NO se arregla en este XML:
  "Android 14+ requires Foreground Service types declaration and justification".
  El manifest ya cumple lo que el sistema exige. Solo falta rellenar la
  declaración en Play Console si publicas en Play Store.

  Tras pegar este archivo:
    npm run build && npx cap sync android
  Luego en Android Studio: File → Sync Project with Gradle Files
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingLeanbackLauncher">

    <!-- ==================== PERMISOS DE RED ==================== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ==================== ENERGÍA / FOREGROUND SERVICE / NOTIFICACIONES ==================== -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        tools:targetApi="34" />
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="33" />
    <!-- Solo se pide bajo demanda del usuario (nunca en silencio) -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Bluetooth (compatibilidad auriculares y controles multimedia) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="31" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ==================== HARDWARE (no bloquean instalación) ==================== -->
    <uses-feature
        android:name="android.hardware.audio.output"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!-- ==================== QUERIES (visibilidad de paquetes / ajustes OEM) ==================== -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="audio/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APP_NOTIFICATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
        </intent>
        <intent>
            <action android:name="android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="false"
        android:largeHeap="true"
        tools:targetApi="36"
        tools:replace="android:allowBackup,android:usesCleartextTraffic">

        <!--
          Activity principal.
          supportsPictureInPicture = true → vídeo en ventana flotante.
          launchMode = singleTask → evita múltiples instancias al volver desde notificación.
        -->
        <activity
            android:name="com.savitarxeno.gco.MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:excludeFromRecents="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density|fontScale|layoutDirection">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Botones multimedia de auriculares / Bluetooth -->
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </activity>

        <!-- FileProvider (necesario para compartir archivos) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true"
            tools:replace="android:authorities">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          @capgo/capacitor-media-session
          - foregroundServiceType="mediaPlayback" → obligatorio en Android 14+
          - exported="true" → patrón oficial para que el sistema / Bluetooth / Android Auto
            puedan enlazar con el servicio
          - stopWithTask="false" → el FGS no se mata al quitar la app de recientes
            (muy importante en One UI y HyperOS)
        -->
        <service
            android:name="com.capgo.mediasession.MediaSessionService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false"
            tools:replace="android:exported,android:foregroundServiceType,android:stopWithTask"
            tools:targetApi="34"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

    </application>
</manifest>