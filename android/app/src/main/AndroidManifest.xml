<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml — GCO (Capacitor 8)
  Android 9 (API 28) → 16+ (API 36+)
  AOSP · Samsung One UI 5–8 · Xiaomi/Redmi HyperOS

  appId: com.savitarxeno.gco

  Tras pegar:
    npm run build
    npx cap sync android
  Luego en Android Studio: File → Sync Project with Gradle Files
  (Los "Unresolved class" suelen desaparecer al terminar el sync.)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingLeanbackLauncher">

    <!-- Red -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Energía / FGS media / notificaciones -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        tools:targetApi="34" />
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="33" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30"
        tools:targetApi="1" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Hardware (no bloquean instalación en tablets, etc.) -->
    <uses-feature
        android:name="android.hardware.audio.output"
        android:required="true"
        tools:targetApi="5" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"
        tools:targetApi="5" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false"
        tools:targetApi="5" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false"
        tools:targetApi="5" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false"
        tools:targetApi="21" />

    <!-- Visibilidad de paquetes / ajustes OEM -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="audio/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APP_NOTIFICATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
        </intent>
        <intent>
            <action android:name="android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="false"
        android:largeHeap="true"
        tools:targetApi="36"
        tools:replace="android:allowBackup,android:usesCleartextTraffic">

        <!--
          Nombre completo = applicationId (capacitor appId).
          Evita "Unresolved class '.MainActivity'" en el analizador del IDE.
        -->
        <activity
            android:name="com.savitarxeno.gco.MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:excludeFromRecents="false"
            android:showWhenLocked="false"
            android:turnScreenOn="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density|fontScale|layoutDirection"
            tools:targetApi="24">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true"
            tools:replace="android:authorities">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          @capgo/capacitor-media-session (gadget + audio en 2º plano)
          stopWithTask=false → no matar el FGS al quitar de recientes (One UI / HyperOS)
        -->
        <service
            android:name="com.capgo.mediasession.MediaSessionService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false"
            tools:replace="android:exported,android:foregroundServiceType,android:stopWithTask"
            tools:targetApi="34">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!--
          Botones multimedia (auriculares / Bluetooth).
          La clase viene de androidx.media (la arrastra Capgo al hacer sync).
          Si el IDE marca Unresolved antes del sync, es normal; tras Gradle desaparece.
        -->

    </application>
</manifest>